@{
    ViewData["Title"] = "Home";
}

<!-- Hero section -->

<section class="p-5 mb-4 bg-dark text-white rounded-3 text-center">
    <h1 class="display-4 fw-bold">Welcome to TechNest</h1>
    <p class="lead">Chargers, cases, earbuds and more.Your one stop for mobile accessories and gadgets.</p>
    <a href="#" class="btn btn-primary btn-lg">Shop Now</a>
</section>

<!-- Categories -->
<h2 class="mb-3">Shop by Category</h2>
<div class="row g-4">
    <div class="col-md-4">
        <div class="card h-100 text-center">
            <div class="card-body">
                <h5 class="card-title">Chargers and Cables</h5>
                <p class="card-text">Fast chargers, cables and power banks.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 text-center">
            <div class="card-body">
                <h5 class="card-title">Audio</h5>
                <p class="card-text">Earbuds, headphones and speakers.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 text-center">
            <div class="card-body">
                <h5 class="card-title">Cases and Protection</h5>
                <p class="card-text">Phone cases and screen protectors.</p>
            </div>
        </div>
    </div>
</div>