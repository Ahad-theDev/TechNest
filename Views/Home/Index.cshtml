@model List<TechNest.Models.Category>
@{
    ViewData["Title"] = "Home";
}

@section Styles {
    <style>
        .category-card {
            transition: transform .15s ease, box-shadow .15s ease;
        }

        .category-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 .5rem 1rem rgba(0, 0, 0, .15);
        }
    </style>
}

@section PageBanner {
    <section class="p-5 mb-4 bg-dark text-white text-center">
        <h1 class="display-4 fw-bold">Welcome to TechNest</h1>
        <p class="lead">Chargers, cases, earbuds and more. Your one stop for mobile accessories and gadgets.</p>
        <a asp-controller="Products" asp-action="Index" class="btn btn-primary btn-lg">Shop Now</a>
    </section>
}

<h2 class="mb-3">Shop by Category</h2>

@if (!Model.Any())
{
    <p class="text-muted">No categories yet.</p>
}

<div class="row g-4">
    @foreach (var category in Model)
    {
        <div class="col-md-4">
            <div class="card category-card h-100 text-center">
                <div class="card-body">
                    <h5 class="card-title">@category.Name</h5>
                    <p class="card-text">@category.Description</p>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        console.log("TechNest home page loaded");
    </script>
}