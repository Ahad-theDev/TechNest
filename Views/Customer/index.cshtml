@{
    ViewData["Title"] = "Customer Home";
}

<div class="p-4 mb-4 bg-light rounded-3">
    <h1>Welcome, Customer</h1>
    <p class="lead mb-0">Browse products, check your cart and track your orders.</p>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card h-100 text-center">
            <div class="card-body">
                <h5 class="card-title">My Cart</h5>
                <p class="card-text">See the items you added.</p>
                <a href="#" class="btn btn-primary">Open Cart</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 text-center">
            <div class="card-body">
                <h5 class="card-title">My Orders</h5>
                <p class="card-text">Track your past and current orders.</p>
                <a href="#" class="btn btn-primary">View Orders</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 text-center">
            <div class="card-body">
                <h5 class="card-title">My Profile</h5>
                <p class="card-text">Update your account details.</p>
                <a href="#" class="btn btn-primary">Edit Profile</a>
            </div>
        </div>
    </div>
</div>